<main class="checkout-container">
    <section class="checkout-card" style="display: flex; flex-direction: column; align-items: center; gap: 30px; max-width: 800px; margin: 0 auto;">
        <div class="product-image" style="max-width: 400px; width: 100%;">
            <img src="{{ product.featured_image | img_url: '600x600' }}" alt="{{ product.title }}" style="width: 100%; border-radius: 20px;">
        </div>
        
        <div class="product-info" style="text-align: center;">
            <h1 style="color: #EC4899; font-size: 32px; margin-bottom: 10px;">{{ product.title }}</h1>
            <div class="price" style="font-size: 24px; font-weight: 700; margin-bottom: 20px;">{{ product.price | money }}</div>
            
            <div class="product-description" style="color: #555; line-height: 1.6; margin-bottom: 30px;">
                {{ product.description }}
            </div>

            {% form 'product', product %}
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <div style="display: flex; flex-direction: column; gap: 15px; align-items: center;">
                    <div class="quantity-selector" style="display: flex; align-items: center; gap: 15px; background: #f9f9f9; padding: 10px 20px; border-radius: 50px;">
                        <label for="Quantity" style="font-weight: 600;">Quantity</label>
                        <input type="number" id="Quantity" name="quantity" value="1" min="1" style="width: 60px; border: none; background: transparent; font-size: 18px; text-align: center;">
                    </div>
                    <button type="submit" name="add" class="btn-primary" style="width: 100%; max-width: 300px;">Add to Cart ♥</button>
                </div>
            {% endform %}
        </div>
    </section>
</main>
