                    <h3>Mini Mischief</h3>
                    <p class="price">$12.00</p>
                </div>
                <div class="cart-controls">
                    <button class="remove-btn" data-product="Mini Mischief">-</button>
                    <span class="item-count" data-product="Mini Mischief">0</span>
                    <button class="add-btn" data-product="Mini Mischief">+</button>
                </div>
            </div>

            <!-- Standard Sparkle -->
            <div class="product-card">
                <span class="tag tag-bestseller">Best Seller</span>
                <div class="product-image" onclick="openModal('Standard Sparkle')">
                    <img src="{{ 'Paket 2.png' | asset_url }}" alt="Standard Sparkle Scoop">
                </div>
                <div class="product-info">
                    <h3>Standard Sparkle</h3>
                    <p class="price">$25.00</p>
                </div>
                <div class="cart-controls">
                    <button class="remove-btn" data-product="Standard Sparkle">-</button>
                    <span class="item-count" data-product="Standard Sparkle">0</span>
                    <button class="add-btn" data-product="Standard Sparkle">+</button>
                </div>
            </div>

            <!-- Deluxe Dream -->
            <div class="product-card">
                <div class="product-image" onclick="openModal('Deluxe Dream')">
                    <img src="{{ 'Paket 3.png' | asset_url }}" alt="Deluxe Dream Scoop">
                </div>
                <div class="product-info">
                    <h3>Deluxe Dream</h3>
                    <p class="price">$45.00</p>
                </div>
                <div class="cart-controls">
                    <button class="remove-btn" data-product="Deluxe Dream">-</button>
                    <span class="item-count" data-product="Deluxe Dream">0</span>
                    <button class="add-btn" data-product="Deluxe Dream">+</button>
                </div>
            </div>

            <!-- Ultimate Chaos -->
            <div class="product-card">
                <div class="product-image" onclick="openModal('Ultimate Chaos')">
                    <img src="{{ 'Paket 4.png' | asset_url }}" alt="Ultimate Chaos Scoop">
                </div>
                <div class="product-info">
                    <h3>Ultimate Chaos</h3>
                    <p class="price">$75.00</p>
                </div>
                <div class="cart-controls">
                    <button class="remove-btn" data-product="Ultimate Chaos">-</button>
                    <span class="item-count" data-product="Ultimate Chaos">0</span>
                    <button class="add-btn" data-product="Ultimate Chaos">+</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Product Information Modal -->
    <div id="product-modal" class="modal">
        <div class="modal-content">
            <span class="close-modal" onclick="closeModal()">&times;</span>
            <div class="modal-body">
