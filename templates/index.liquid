                <h2 id="modal-title" class="modal-title">Product Name</h2>
                <div id="modal-scoops" class="modal-scoops">0 Scoops</div>
                <p id="modal-desc" class="modal-description">Product description goes here...</p>
                <button class="btn-primary" onclick="closeModal()">Got it! ♥</button>
            </div>
        </div>
    </div>

    <!-- Social Feed Section -->
    <div class="social-feed">
        <div class="hashtag-scroll">
            <div class="scroll-content">
                <span>#LUCKYSCOOPLOVER</span>
                <span>#KAWAIICHAOS</span>
                <span>#MISCHIEFMODE</span>
                <span>#LUCKYSCOOPLOVER</span>
                <span>#KAWAIICHAOS</span>
                <span>#MISCHIEFMODE</span>
                <span>#LUCKYSCOOPLOVER</span>
                <span>#KAWAIICHAOS</span>
                <span>#MISCHIEFMODE</span>
            </div>
        </div>
        
        <div class="social-grid">
            <div class="social-item"><img src="{{ 'Instagram.png' | asset_url }}" alt="Social Post 1"></div>
            <div class="social-item"><img src="{{ 'Tik-Tok.png' | asset_url }}" alt="Social Post 2"></div>
            <div class="social-item"><img src="{{ 'Instagram.png' | asset_url }}" alt="Social Post 3"></div>
            <div class="social-item"><img src="{{ 'Tik-Tok.png' | asset_url }}" alt="Social Post 4"></div>
        </div>
    </div>

    <!-- FOOTER -->
    <footer class="main-footer">
        <div class="footer-content">
            <div class="footer-links">
                <a href="/policies/privacy-policy">Privacy Policy</a>
                <a href="/policies/terms-of-service">Terms of Service</a>
                <a href="/pages/contact-us">Contact Us</a>
            </div>
            <div style="margin-bottom: 25px;">
                <a href="https://youtu.be/dQw4w9WgXcQ" target="_blank" class="btn-primary" style="display: inline-block; text-decoration: none;">Free scoop here ♥</a>
            </div>
            <p class="copyright">&copy; {{ 'now' | date: "%Y" }} Lucky Mystery Scoops. All rights reserved.</p>
        </div>
    </footer>
</section>

<script>
    // Cart logic using localStorage (Keep for now, but Shopify would use Cart API)
    let cart = JSON.parse(localStorage.getItem('cart')) || [];
    const badge = document.getElementById('cart-count');
    
    function updateUI() {
        if (badge) {
            if (cart.length > 0) {
                badge.innerText = cart.length;
                badge.style.display = 'flex';
            } else {
                badge.style.display = 'none';
            }
        }

        const counts = {};
        cart.forEach(item => {
            counts[item.name] = (counts[item.name] || 0) + 1;
        });

        document.querySelectorAll('.item-count').forEach(span => {
            const productName = span.getAttribute('data-product');
            span.innerText = counts[productName] || 0;
        });
    }
    
    updateUI();
    
    document.querySelectorAll('.add-btn').forEach(button => {
        button.addEventListener('click', (e) => {
            const card = e.target.closest('.product-card');
            const name = card.querySelector('h3').innerText;
            const price = card.querySelector('.price').innerText;
            
            cart.push({ name, price });
            localStorage.setItem('cart', JSON.stringify(cart));
            
            updateUI();
            
            if (badge) {
                badge.style.transform = 'scale(1.2)';
                setTimeout(() => badge.style.transform = 'scale(1)', 100);
            }
        });
    });

    document.querySelectorAll('.remove-btn').forEach(button => {
        button.addEventListener('click', (e) => {
            const productName = e.target.getAttribute('data-product');
            const index = cart.findIndex(item => item.name === productName);
            
            if (index !== -1) {
                cart.splice(index, 1);
                localStorage.setItem('cart', JSON.stringify(cart));
                updateUI();
            }
        });
    });

    const productData = {
        "Mini Mischief": {
            scoops: "1 Scoop",
            desc: "A perfect little taste of mischief! This mini scoop includes a curated selection of charms and treasures to start your collection.",
            img: "{{ 'Paket 1.png' | asset_url }}"
        },
        "Standard Sparkle": {
            scoops: "2 Scoops",
            desc: "Double the fun! Our standard sparkle pack gives you twice the treasures and a higher chance of finding rare gothic charms.",
            img: "{{ 'Paket 2.png' | asset_url }}"
        },
        "Deluxe Dream": {
            scoops: "4 Scoops",
            desc: "The ultimate dreamer's choice. Four full scoops of magic, including guaranteed premium charms and extra sparkles.",
            img: "{{ 'Paket 3.png' | asset_url }}"
        },
        "Ultimate Chaos": {
            scoops: "7 Scoops",
            desc: "Pure, unadulterated chaos! Seven massive scoops for the ultimate collector. This pack is overflowing with our rarest and most mischievous finds.",
            img: "{{ 'Paket 4.png' | asset_url }}"
        }
    };

    function openModal(name) {
        const data = productData[name];
        document.getElementById('modal-img').src = data.img;
        document.getElementById('modal-title').innerText = name;
        document.getElementById('modal-scoops').innerText = data.scoops;
        document.getElementById('modal-desc').innerText = data.desc;
        document.getElementById('product-modal').style.display = 'flex';
    }

    function closeModal() {
        document.getElementById('product-modal').style.display = 'none';
    }

    window.onclick = function(event) {
        const modal = document.getElementById('product-modal');
        if (event.target == modal) {
            closeModal();
        }
    }
</script>
