<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ page_title }}</title>
    
    {{ content_for_header }}

    {{ 'style.css' | asset_url | stylesheet_tag }}
</head>
<body class="{% if template contains 'page' %}checkout-body{% endif %}">

    <header class="main-header">
        <div class="logo-container">
            <a href="/">
                <img src="{{ 'Logga v1.png' | asset_url }}" alt="Lucky Scoop Logo" class="logo">
            </a>
            <h1 class="lucky-title">Lucky Mystery Scoops</h1>
        </div>

        <nav class="nav-links">
            <a href="/">Home</a>
            <a href="/#how-it-works">How it works</a>
            <a href="/#shop">Shop</a>
            <a href="/pages/about-us">About us</a>
        </nav>

        <div class="header-icons">
            <a href="https://www.tiktok.com/@lucky.mysteryscoop?_r=1&_t=ZN-96Qx06VUTvK" target="_blank" class="icon-link">
                <img src="{{ 'Tik-Tok.png' | asset_url }}" class="social-icon" alt="TikTok">
            </a>
            <a href="https://www.instagram.com/lucky.mystery.scoop?igsh=Y2NkdXpzMDN5bXI2&utm_source=qr" target="_blank" class="icon-link">
                <img src="{{ 'Instagram.png' | asset_url }}" class="social-icon" alt="Instagram">
            </a>
            <a href="/cart" class="icon-link cart-wrapper">
                <img src="{{ 'shopping_cart_24dp_EC4899_FILL0_wght400_GRAD0_opsz24.svg' | asset_url }}" class="cart-icon" alt="Cart">
                <span class="cart-badge" id="cart-count" style="display: none;">0</span>
            </a>
        </div>
    </header>

    <main role="main">
        {{ content_for_layout }}
    </main>

</body>
</html>
